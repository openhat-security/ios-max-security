# Copy to mdm/.env and edit. Never commit .env.

# self = this compose stack. openhat = generate enrollment against a hosted URL.
MDM_PROVIDER=self

# Public HTTPS origin (no trailing slash). Must match the certificate name.
MDM_PUBLIC_URL=https://mdm.example.com
MDM_HOSTNAME=mdm.example.com
ACME_EMAIL=you@example.com

# SCEP enrollment challenge (device must present this).
SCEP_CHALLENGE=change-me-scep-challenge

# NanoMDM HTTP basic password (username is always "nanomdm").
NANOMDM_API_KEY=change-me-api-key

# Filled in after: ./upload_pushcert.sh
# Example: com.apple.mgmt.External.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
MDM_TOPIC=com.apple.mgmt.External.REPLACE_ME

# MDM AccessRights bitfield. 8191 = all (including remote wipe).
# See Apple MDM payload AccessRights.
ACCESS_RIGHTS=8191

# Optional path to APNs push cert + unencrypted key (PEM).
PUSH_CERT_PEM=pki/push.pem
PUSH_CERT_KEY=pki/push.key
