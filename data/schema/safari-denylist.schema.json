{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "safari-denylist.schema.json",
  "title": "Safari deny-list URLs",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["url"],
        "properties": {
          "url": { "type": "string", "format": "uri" }
        }
      }
    }
  }
}
