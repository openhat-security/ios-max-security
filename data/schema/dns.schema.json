{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dns.schema.json",
  "title": "Encrypted DNS providers",
  "type": "object",
  "required": ["items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "short", "protocol", "url", "addresses", "notes"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "short": { "type": "string" },
          "protocol": { "enum": ["HTTPS", "TLS"] },
          "url": { "type": "string", "format": "uri" },
          "addresses": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
