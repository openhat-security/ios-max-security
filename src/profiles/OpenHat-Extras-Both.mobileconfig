<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>PayloadType</key>
	<string>Configuration</string>
	<key>PayloadVersion</key>
	<integer>1</integer>
	<key>PayloadUUID</key>
	<string>6304DF87-9E67-54D4-B927-D6CE4A6B43D9</string>
	<key>PayloadIdentifier</key>
	<string>org.openhat.ios-max-privacy.extras</string>
	<key>PayloadDisplayName</key>
	<string>OpenHat Additional Profiles</string>
	<key>PayloadDescription</key>
	<string>Passcode policy and Safari content filter.</string>
	<key>PayloadOrganization</key>
	<string>OpenHat</string>
	<key>PayloadRemovalDisallowed</key>
	<false/>
	<key>PayloadScope</key>
	<string>System</string>
	<key>ConsentText</key>
	<dict>
		<key>default</key>
		<string>This additional configuration profile includes a passcode policy and a Safari content filter. Install it if Level 1 is already on this iPhone and you do not want to replace that profile.

A passcode policy requires a code that is not a simple pattern and is at least 6 characters. The Safari filter blocks listed sites in Safari only; Instagram and Snapchat apps still work.</string>
	</dict>
	<key>PayloadContent</key>
	<array>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.mobiledevice.passwordpolicy</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadUUID</key>
			<string>D570C462-19FC-5996-9258-50AA414A6049</string>
			<key>PayloadIdentifier</key>
			<string>org.openhat.ios-max-privacy.passcode</string>
			<key>PayloadDisplayName</key>
			<string>OpenHat Passcode Policy</string>
			<key>PayloadDescription</key>
			<string>Require a non-simple passcode of at least 6 characters; lock immediately.</string>
			<key>PayloadOrganization</key>
			<string>OpenHat</string>
			<key>forcePIN</key>
			<true/>
			<key>allowSimple</key>
			<false/>
			<key>minLength</key>
			<integer>6</integer>
			<key>maxGracePeriod</key>
			<integer>0</integer>
			<key>maxInactivity</key>
			<integer>2</integer>
			<key>requireAlphanumeric</key>
			<false/>
		</dict>
		<dict>
			<key>PayloadType</key>
			<string>com.apple.webcontent-filter</string>
			<key>PayloadVersion</key>
			<integer>1</integer>
			<key>PayloadUUID</key>
			<string>4E0A10DF-A861-52AF-8504-037059AD5041</string>
			<key>PayloadIdentifier</key>
			<string>org.openhat.ios-max-privacy.webfilter</string>
			<key>PayloadDisplayName</key>
			<string>OpenHat Safari Tracker Deny List</string>
			<key>PayloadDescription</key>
			<string>Blocks known tracker and social-graph sites in Safari. Native apps are unaffected.</string>
			<key>PayloadOrganization</key>
			<string>OpenHat</string>
			<key>FilterType</key>
			<string>BuiltIn</string>
			<key>AutoFilterEnabled</key>
			<false/>
			<key>UserDefinedName</key>
			<string>OpenHat Safari Deny List</string>
			<key>ContentFilterUUID</key>
			<string>CCF8B5CF-710C-5A2F-B937-04D45D2E2937</string>
			<key>DenyListURLs</key>
			<array>
				<string>https://www.facebook.com</string>
				<string>https://m.facebook.com</string>
				<string>https://www.instagram.com</string>
				<string>https://www.snapchat.com</string>
				<string>https://www.tiktok.com</string>
				<string>https://www.doubleclick.net</string>
				<string>https://googleads.g.doubleclick.net</string>
				<string>https://pagead2.googlesyndication.com</string>
				<string>https://www.google-analytics.com</string>
				<string>https://graph.facebook.com</string>
				<string>https://connect.facebook.net</string>
				<string>https://ads.twitter.com</string>
				<string>https://analytics.tiktok.com</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
